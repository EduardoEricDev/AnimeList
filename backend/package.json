{
  "name": "animelist-backend",
  "version": "1.0.0",
  "description": "AnimeList Cloudflare D1 & Worker Backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute animelist-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute animelist-db --remote --file=./schema.sql",
    "db:create": "wrangler d1 create animelist-db",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}

