# ==============================================================================
# AnimeList - .gitignore
# Protege e oculta arquivos de sistema, credenciais, logs e atalhos locais
# ==============================================================================

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Variáveis de ambiente e segredos locais
.env
.env.local
.env.*
*.env

# Atalhos e arquivos de inicialização locais
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs e Editores de Código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.user

# Diretórios e arquivos temporários de compilação ou testes
temp/
tmp/
scratch/
*.bak
backups/
*.orig

# Dependências
node_modules/
